{
  "name": "Template Tauri React",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "IsabellaKPM",
  "license": "MIT",
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "tauri": "tauri",
    "start:dev": "tauri dev",
    "start:fe": "vite",
    "start:preview": "vite preview",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "typecheck:fe": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:fe",
    "format:fe": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,css}\" \"*.ts\"",
    "format:fe:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,json,css}\" \"*.ts\"",
    "format:be": "cd src-tauri && cargo fmt",
    "format:be:check": "cd src-tauri && cargo fmt --check",
    "format": "pnpm run format:fe && pnpm run format:be",
    "format:check": "pnpm run format:fe:check && pnpm run format:be:check",
    "lint:fe": "eslint .",
    "lint:fe:fix": "eslint . --fix",
    "lint:be": "cd src-tauri && cargo clippy -- -D warnings",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fix": "pnpm run lint:fe:fix && pnpm run format:be",
    "test:fe": "playwright test",
    "test:fe:ui": "playwright test --ui",
    "test:fe:report": "playwright show-report",
    "test:be": "cd src-tauri && cargo test",
    "test": "pnpm run test:fe && pnpm run test:be",
    "ci:fe": "pnpm run typecheck:fe && pnpm run lint:fe && pnpm run format:fe:check",
    "ci:be": "pnpm run format:be:check && pnpm run lint:be && pnpm run test:be",
    "ci:check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "ci": "pnpm run ci:check && pnpm run test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
